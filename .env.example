# Copy this file to .env and fill in your key. Never commit .env.
# Free key: https://aistudio.google.com  ->  "Get API key"
GEMINI_API_KEY=your-key-here

# Any Flash / Flash-Lite model on the free tier. Check the rate-limit page in
# AI Studio if you get a 429 with "limit: 0" and switch to a model listed there.
SENTINEL_MODEL=gemini-3.8-flash
